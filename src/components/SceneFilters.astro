---
import SceneIcon from "./SceneIcon.astro";

interface Props {
  scenes: { id: string; name: string }[];
  allLabel?: string;
}

const { scenes, allLabel = "全部" } = Astro.props;
---

<div class="filters" data-filter-bar role="group" aria-label="场景筛选">
  <button type="button" class="filter-chip" data-filter="" aria-pressed="true">
    {allLabel}
  </button>
  {
    scenes.map((scene) => (
      <button
        type="button"
        class="filter-chip"
        data-filter={scene.id}
        aria-pressed="false"
      >
        <SceneIcon name={scene.id} size={16} />
        {scene.name}
      </button>
    ))
  }
</div>

<script>
  function applyFilter(bar: Element, value: string) {
    const chips = bar.querySelectorAll<HTMLButtonElement>("[data-filter]");
    const items = document.querySelectorAll("[data-scenes]");
    chips.forEach((c) =>
      c.setAttribute("aria-pressed", String((c.dataset.filter ?? "") === value)),
    );
    items.forEach((item) => {
      const scenes = (item.getAttribute("data-scenes") || "")
        .split(/\s+/)
        .filter(Boolean);
      (item as HTMLElement).hidden = !!value && !scenes.includes(value);
    });
    const visible = [...items].some((el) => !(el as HTMLElement).hidden);
    const empty = document.querySelector<HTMLElement>("[data-filter-empty]");
    if (empty) empty.hidden = visible;
  }

  function bindFilters() {
    const bar = document.querySelector("[data-filter-bar]");
    if (!bar) return;
    bar
      .querySelectorAll<HTMLButtonElement>("[data-filter]")
      .forEach((chip) =>
        chip.addEventListener("click", () =>
          applyFilter(bar, chip.dataset.filter ?? ""),
        ),
      );

    const initial = new URLSearchParams(location.search).get("scene");
    if (initial) applyFilter(bar, initial);
  }

  bindFilters();
</script>
