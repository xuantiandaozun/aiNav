---
interface Props {
  size?: number;
  text?: boolean;
}

const { size = 34, text = true } = Astro.props;
---

<span class="logo">
  <svg
    class="logo__mark"
    width={size}
    height={size}
    viewBox="0 0 40 40"
    role="img"
    aria-label="AI 用法入口"
  >
    <rect width="40" height="40" rx="11" fill="#0d6b58"></rect>
    <path
      d="M20 8c1 6 6 11 12 12-6 1-11 6-12 12-1-6-6-11-12-12 6-1 11-6 12-12z"
      fill="#ffffff"></path>
    <circle cx="31" cy="10" r="2.6" fill="#8fe3cc"></circle>
  </svg>
  {
    text && (
      <span class="logo__text">
        <b>AI 用法入口</b>
        <small>热点 · 工具 · 案例</small>
      </span>
    )
  }
</span>
