---
import SceneIcon from "./SceneIcon.astro";
import ToolAvatar from "./ToolAvatar.astro";
import { primaryScene, sceneName, type Tool } from "../lib/data";

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const unstable = tool.access === "打开不稳定";
---

<a
  class="tool-card"
  href={`/tools/${tool.slug}/`}
  data-scenes={tool.scenes.join(" ")}
>
  <div class="tool-card__top">
    <ToolAvatar
      name={tool.name}
      slug={tool.slug}
      scene={primaryScene(tool)}
      size={46}
    />
    <div>
      <p class="tool-card__name">{tool.name}</p>
      <p class="tool-card__price">{tool.price}</p>
    </div>
  </div>
  <p class="tool-card__summary">{tool.summary}</p>
  <div class="tool-card__foot">
    {
      tool.scenes.map((id) => (
        <span class={`scene-tag scene-${id}`}>
          <SceneIcon name={id} size={13} />
          {sceneName(id)}
        </span>
      ))
    }
    <span class={unstable ? "access access--warn" : "access"}>{tool.access}</span>
  </div>
</a>
