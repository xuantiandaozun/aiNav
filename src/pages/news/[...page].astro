---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SceneFilters from "../../components/SceneFilters.astro";
import { formatDate, scenes, sortedNews } from "../../lib/data";

export async function getStaticPaths({ paginate }: { paginate: Function }) {
  const news = sortedNews();
  if (news.length === 0) {
    return [
      {
        params: { page: undefined },
        props: {
          page: {
            data: [],
            currentPage: 1,
            url: { prev: undefined, next: undefined },
          },
        },
      },
    ];
  }
  return paginate(news, { pageSize: 20 });
}

const { page } = Astro.props;
const isFirst = page.currentPage === 1;
---

<BaseLayout
  title={isFirst ? "AI 热点" : `AI 热点 · 第 ${page.currentPage} 页`}
  description="来自公开来源的 AI 动态标题与短摘，点击前往原文。"
  active="news"
>
  <div class="page-head">
    <h1>热点</h1>
    <p>内容来自公开 RSS，本站只保留标题、来源、时间和短摘。点击前往原文阅读。</p>
  </div>

  <SceneFilters scenes={scenes} />

  {
    page.data.length === 0 ? (
      <div class="empty">还没有热点。采集任务运行后会出现在这里。</div>
    ) : (
      <>
        <div class="list">
          {page.data.map((item) => (
            <article
              class="row"
              data-scenes={item.scenes.join(" ")}
            >
              <p class="row__title">
                <a href={item.sourceUrl} target="_blank" rel="noopener noreferrer">
                  {item.title}
                </a>
              </p>
              <div class="row__meta">
                <span>{item.sourceName}</span>
                <span>{formatDate(item.publishedAt)}</span>
                {item.scenes.map((id) => (
                  <span class="tag">{scenes.find((s) => s.id === id)?.name}</span>
                ))}
              </div>
              {item.excerpt ? <p class="row__summary">{item.excerpt}</p> : null}
              <p class="row__summary">
                <a href={item.sourceUrl} target="_blank" rel="noopener noreferrer">
                  阅读原文
                </a>
              </p>
            </article>
          ))}
        </div>
        <div class="empty" data-filter-empty hidden>这个场景暂时没有热点。</div>
        <div class="pager">
          {page.url.prev ? <a href={page.url.prev}>上一页</a> : null}
          {page.url.next ? <a href={page.url.next}>下一页</a> : null}
        </div>
      </>
    )
  }
</BaseLayout>
