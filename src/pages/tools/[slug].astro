---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SceneIcon from "../../components/SceneIcon.astro";
import ToolAvatar from "../../components/ToolAvatar.astro";
import CaseCard from "../../components/CaseCard.astro";
import {
  allTools,
  casesForTool,
  formatDate,
  primaryScene,
  sceneName,
} from "../../lib/data";

export function getStaticPaths() {
  return allTools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const publicTool = tool.status === "公开";
const related = publicTool ? casesForTool(tool.slug) : [];
const unstable = tool.access === "打开不稳定";
---

<BaseLayout
  title={publicTool ? tool.name : "工具未公开"}
  description={publicTool ? tool.summary : "这个工具没有公开"}
  active="tools"
>
  {
    publicTool ? (
      <article class="detail">
        <div class="detail__head">
          <ToolAvatar
            name={tool.name}
            slug={tool.slug}
            scene={primaryScene(tool)}
            size={68}
          />
          <div>
            <h1>{tool.name}</h1>
            <p class="detail__lead">{tool.summary}</p>
          </div>
        </div>
        <div class="chips">
          {tool.scenes.map((id) => (
            <span class={`scene-tag scene-${id}`}>
              <SceneIcon name={id} size={13} />
              {sceneName(id)}
            </span>
          ))}
          <span class="tag">{tool.price}</span>
          <span class={unstable ? "access access--warn" : "access"}>{tool.access}</span>
        </div>
        <dl class="facts">
          <div>
            <dt>网络情况</dt>
            <dd>
              {tool.access}
              {tool.note ? `。${tool.note}` : ""}
            </dd>
          </div>
          <div>
            <dt>信息更新</dt>
            <dd>{formatDate(tool.updatedAt)}</dd>
          </div>
        </dl>
        <div class="actions">
          <a
            class="btn btn--primary"
            href={tool.websiteUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            打开官网
            <SceneIcon name="external" size={16} />
          </a>
          <a class="btn btn--ghost" href="/tools/">返回导航</a>
        </div>

        {related.length > 0 ? (
          <section class="section" aria-labelledby="related-cases">
            <div class="section__head">
              <div class="section__title">
                <span class="section__icon"><SceneIcon name="cases" size={20} /></span>
                <h2 id="related-cases">用到这个工具的案例</h2>
              </div>
            </div>
            <div class="case-grid">
              {related.map((item) => (
                <CaseCard item={item} />
              ))}
            </div>
          </section>
        ) : null}
      </article>
    ) : (
      <div class="empty">
        <p>这个工具没有公开。</p>
        <p><a href="/tools/">返回导航</a></p>
      </div>
    )
  }
</BaseLayout>
