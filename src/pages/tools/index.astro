---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SceneFilters from "../../components/SceneFilters.astro";
import SceneIcon from "../../components/SceneIcon.astro";
import ToolCard from "../../components/ToolCard.astro";
import { publishedTools, scenes } from "../../lib/data";

const tools = publishedTools();
---

<BaseLayout
  title="AI 工具导航"
  description="按写作、绘图、视频、编程、办公找可用的 AI 工具。"
  active="tools"
>
  <div class="page-head">
    <span class="section__icon"><SceneIcon name="tools" size={26} /></span>
    <div>
      <h1>导航</h1>
      <p>按场景筛选工具。卡片上会写清做什么、要不要付钱、国内能不能直接打开。</p>
    </div>
  </div>

  <SceneFilters scenes={scenes} />

  {
    tools.length === 0 ? (
      <div class="empty">还没有工具。</div>
    ) : (
      <>
        <div class="tool-grid">
          {tools.map((tool) => (
            <ToolCard tool={tool} />
          ))}
        </div>
        <div class="empty" data-filter-empty hidden>这个场景暂时没有工具。</div>
      </>
    )
  }
</BaseLayout>
