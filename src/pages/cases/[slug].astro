---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  allCases,
  formatDate,
  getTool,
  sceneName,
} from "../../lib/data";

export function getStaticPaths() {
  return allCases.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const publicCase = item.status === "公开";
const linkedTools = item.tools.map((slug) => {
  const tool = getTool(slug);
  return { slug, tool };
});
---

<BaseLayout
  title={publicCase ? item.title : "案例未公开"}
  description={publicCase ? item.summary : "这条内容还没有公开"}
  active="cases"
>
  {
    publicCase ? (
      <article class="detail">
        <h1>{item.title}</h1>
        <div class="row__meta">
          <span class="tag tag--accent">{sceneName(item.scene)}</span>
          {item.publishedAt ? <span>{formatDate(item.publishedAt)}</span> : null}
        </div>

        <dl>
          <div>
            <dt>这种方法在做什么</dt>
            <dd>{item.summary}</dd>
          </div>
          <div>
            <dt>用到的工具</dt>
            <dd>
              <div class="list" style="margin-top:8px">
                {linkedTools.map(({ slug, tool }) =>
                  tool && tool.status === "公开" ? (
                    <a class="row" href={`/tools/${tool.slug}/`}>
                      <p class="row__title">{tool.name}</p>
                      <p class="row__summary">{tool.summary}</p>
                    </a>
                  ) : tool && tool.status === "已下线" ? (
                    <div class="row">
                      <p class="row__title">{tool.name}</p>
                      <p class="row__summary">已下线，暂不提供官网入口。</p>
                    </div>
                  ) : (
                    <div class="row">
                      <p class="row__title">{slug}</p>
                      <p class="row__summary">工具信息暂缺。</p>
                    </div>
                  ),
                )}
              </div>
            </dd>
          </div>
          <div>
            <dt>时间成本</dt>
            <dd>{item.timeCost}</dd>
          </div>
          <div>
            <dt>收入说法</dt>
            <dd>来源声称：{item.incomeClaim}</dd>
          </div>
          <div>
            <dt>来源</dt>
            <dd>
              {item.sourceName}
              {" · "}
              <a href={item.sourceUrl} target="_blank" rel="noopener noreferrer">
                查看来源
              </a>
            </dd>
          </div>
        </dl>

        <div class="actions">
          <a class="btn btn--ghost" href="/cases/">返回案例</a>
        </div>
      </article>
    ) : (
      <div class="empty">
        <p>这条内容还没有公开。</p>
        <p><a href="/cases/">返回案例</a></p>
      </div>
    )
  }
</BaseLayout>
