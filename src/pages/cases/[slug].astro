---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CaseCover from "../../components/CaseCover.astro";
import SceneIcon from "../../components/SceneIcon.astro";
import ToolAvatar from "../../components/ToolAvatar.astro";
import {
  allCases,
  formatDate,
  getTool,
  primaryScene,
  sceneName,
} from "../../lib/data";

export function getStaticPaths() {
  return allCases.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const publicCase = item.status === "公开";
const linkedTools = item.tools.map((slug) => ({ slug, tool: getTool(slug) }));
---

<BaseLayout
  title={publicCase ? item.title : "案例未公开"}
  description={publicCase ? item.summary : "这条内容还没有公开"}
  active="cases"
>
  {
    publicCase ? (
      <article class="detail">
        <CaseCover item={item} large />
        <h1 style="margin-top:18px">{item.title}</h1>
        <div class="chips" style="margin-top:0">
          <span class={`scene-tag scene-${item.scene}`}>
            <SceneIcon name={item.scene} size={13} />
            {sceneName(item.scene)}
          </span>
          {item.publishedAt ? (
            <span class="muted">{formatDate(item.publishedAt)}</span>
          ) : null}
        </div>

        <dl class="facts">
          <div>
            <dt>这种方法在做什么</dt>
            <dd>{item.summary}</dd>
          </div>
          <div>
            <dt>用到的工具</dt>
            <dd>
              <div class="linked-tools">
                {linkedTools.map(({ slug, tool }) =>
                  tool && tool.status === "公开" ? (
                    <a class="linked-tool" href={`/tools/${tool.slug}/`}>
                      <ToolAvatar
                        name={tool.name}
                        slug={tool.slug}
                        scene={primaryScene(tool)}
                        size={40}
                      />
                      <div>
                        <b>{tool.name}</b>
                        <span>{tool.summary}</span>
                      </div>
                    </a>
                  ) : tool && tool.status === "已下线" ? (
                    <div class="linked-tool">
                      <ToolAvatar name={tool.name} scene={primaryScene(tool)} size={40} />
                      <div>
                        <b>{tool.name}</b>
                        <span>已下线，暂不提供官网入口。</span>
                      </div>
                    </div>
                  ) : (
                    <div class="linked-tool">
                      <div>
                        <b>{slug}</b>
                        <span>工具信息暂缺。</span>
                      </div>
                    </div>
                  ),
                )}
              </div>
            </dd>
          </div>
          <div>
            <dt>时间成本</dt>
            <dd>{item.timeCost}</dd>
          </div>
          <div>
            <dt>收入说法</dt>
            <dd>
              <span class="claim">来源声称：{item.incomeClaim}</span>
            </dd>
          </div>
          <div>
            <dt>来源</dt>
            <dd>
              {item.sourceName}
              {" · "}
              <a
                href={item.sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
                style="color:var(--accent)"
              >
                查看来源
              </a>
            </dd>
          </div>
        </dl>

        <div class="actions">
          <a class="btn btn--ghost" href="/cases/">返回案例</a>
        </div>
      </article>
    ) : (
      <div class="empty">
        <p>这条内容还没有公开。</p>
        <p><a href="/cases/">返回案例</a></p>
      </div>
    )
  }
</BaseLayout>
