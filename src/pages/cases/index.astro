---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SceneFilters from "../../components/SceneFilters.astro";
import SceneIcon from "../../components/SceneIcon.astro";
import CaseCard from "../../components/CaseCard.astro";
import { publishedCases, scenes } from "../../lib/data";

const cases = publishedCases();
---

<BaseLayout
  title="AI 副业案例"
  description="看别人用哪些 AI 工具做过副业，收入说法均标注来源。"
  active="cases"
>
  <div class="page-head">
    <span class="section__icon"><SceneIcon name="cases" size={26} /></span>
    <div>
      <h1>案例</h1>
      <p>
        每条案例都经过站长改写，并链回原文。收入统一写成「来源声称」，不是本站核实结果。
      </p>
    </div>
  </div>

  <SceneFilters scenes={scenes} />

  {
    cases.length === 0 ? (
      <div class="empty">还没有案例。</div>
    ) : (
      <>
        <div class="case-grid">
          {cases.map((item) => (
            <CaseCard item={item} />
          ))}
        </div>
        <div class="empty" data-filter-empty hidden>这个场景暂时没有案例。</div>
      </>
    )
  }
</BaseLayout>
