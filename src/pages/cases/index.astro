---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SceneFilters from "../../components/SceneFilters.astro";
import { publishedCases, scenes, sceneName } from "../../lib/data";

const cases = publishedCases();
---

<BaseLayout
  title="AI 副业案例"
  description="看别人用哪些 AI 工具做过副业，收入说法均标注来源。"
  active="cases"
>
  <div class="page-head">
    <h1>案例</h1>
    <p>
      每条案例都经过站长改写，并链回原文。收入统一写成「来源声称」，不是本站核实结果。
    </p>
  </div>

  <SceneFilters scenes={scenes} />

  {
    cases.length === 0 ? (
      <div class="empty">还没有案例。</div>
    ) : (
      <>
        <div class="list">
          {cases.map((item) => (
            <a
              class="row"
              href={`/cases/${item.slug}/`}
              data-scenes={item.scene}
            >
              <p class="row__title">{item.title}</p>
              <div class="row__meta">
                <span class="tag tag--accent">{sceneName(item.scene)}</span>
              </div>
              <p class="row__summary">{item.summary}</p>
            </a>
          ))}
        </div>
        <div class="empty" data-filter-empty hidden>这个场景暂时没有案例。</div>
      </>
    )
  }
</BaseLayout>
